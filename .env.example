# Target Application Settings
# Default target is local fixture
TARGET_URL=http://localhost:3000

# Strict Target Allowlist (comma-separated list of authorized domains or IP addresses)
# The scanner will REFUSE to send requests to any host not explicitly listed here.
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Authorization Confirmation
# Must be set to 'true' to confirm you have explicit authorization to test this target
AUTHORIZED_TESTING=true

# Request Concurrency & Timeout
REQUEST_TIMEOUT_MS=5000
MAX_CONCURRENCY=5

# Reporting
REPORT_OUTPUT_DIR=./reports
REPORT_FORMATS=json,markdown

# Environment Mode: development / staging / test
APP_ENV=test
